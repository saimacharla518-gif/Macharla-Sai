<!-- 1. The user inputs their prompt or script on your website -->
<textarea id="userScript" placeholder="Enter your video script here..."></textarea>
<button onclick="generateVideo()">Create Free Video</button>

<div id="videoContainer"></div>

<script>
async function generateVideo() {
  const scriptText = document.getElementById('userScript').value;
  
  // 2. Your website sends the script to the AI video API
  const response = await fetch('https://example-video-provider.com', {
    method: 'POST',
    headers: {
      'Authorization': 'Bearer YOUR_FREE_API_KEY',
      'Content-Type': 'application/json'
    },
    body: JSON.stringify({ prompt: scriptText })
  });
  
  const data = await response.json();
  
  // 3. Your website displays the finished AI video to the user
  document.getElementById('videoContainer').innerHTML = `<video src="${data.video_url}" controls></video>`;
}
</script>
